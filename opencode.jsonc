{
  "$schema": "https://opencode.ai/config.json",
  "model": "runbios/glm-5.3-flash",
  "small_model": "runbios/glm-5.3-flash",
  "default_agent": "build",
  "enabled_providers": [
    "runbios",
    "entrim"
  ],
  "provider": {
    "runbios": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Run BiOS",
      "env": [
        "RUNBIOS_API_KEY"
      ],
      "options": {
        "baseURL": "https://api.runbios.ai/v1",
        "timeout": 600000,
        "chunkTimeout": 60000
      },
      "models": {
        "glm-5.2": {
          "name": "GLM 5.2",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "variants": {
            "low": {},
            "high": {},
            "max": {}
          }
        },
        "glm-5.3": {
          "name": "GLM 5.3",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "variants": {
            "low": {},
            "high": {},
            "max": {}
          }
        },
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "variants": {
            "low": {},
            "high": {},
            "max": {}
          }
        }
      }
    },
    "entrim": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Entrim",
      "options": {
        "baseURL": "https://api.entrim.ai/v1"
      },
      "models": {
        "deepseek-ai/DeepSeek-V4-Flash": {
          "name": "DeepSeek V4 Flash — Entrim",
          "reasoning": true,
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        }
      }
    }
  },
  "agent": {
    "build": {
      "model": "runbios/glm-5.3-flash",
      "variant": "low"
    }
  },
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "external_directory": "allow"
  },
  "instructions": [
    "AGENTS.md",
    "CONTENT_STUDIO_HANDOFF.md",
    "docs/CONTENT_STUDIO_ARCHITECTURE.md",
    "docs/SEO_MASTER_ENGINE.md"
  ]
}
