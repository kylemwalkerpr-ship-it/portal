{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content Studio delivery evidence and executor policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "architectureVersion",
    "implementationEntry",
    "executorPolicy",
    "workerBudget",
    "phaseSnapshot"
  ],
  "properties": {
    "schemaVersion": {
      "const": "studio.delivery/1"
    },
    "architectureVersion": {
      "const": "CS-2026.09.24.1"
    },
    "executorPolicy": {
      "$ref": "#/$defs/executorPolicy"
    },
    "workerBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpuTargetExclusiveMs",
        "p95TargetMs",
        "p99TargetMs",
        "performanceStatus",
        "evidenceRefs"
      ],
      "properties": {
        "cpuTargetExclusiveMs": {
          "const": 10
        },
        "p95TargetMs": {
          "const": 2.5
        },
        "p99TargetMs": {
          "const": 5
        },
        "performanceStatus": {
          "enum": [
            "UNVERIFIED",
            "PASS",
            "FAIL",
            "INSUFFICIENT_EVIDENCE"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "performanceStatus": {
                "const": "PASS"
              }
            }
          },
          "then": {
            "properties": {
              "evidenceRefs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "phaseSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "P0",
        "P1",
        "P2",
        "P3",
        "P4",
        "P5",
        "P6",
        "P7",
        "P8",
        "P9",
        "P10",
        "P11",
        "P12",
        "P13"
      ],
      "properties": {
        "P0": {
          "allOf": [
            {
              "$ref": "#/$defs/phase"
            },
            {
              "properties": {
                "phase": {
                  "const": "P0"
                }
              }
            }
          ]
        },
        "P1": {
          "allOf": [
            {
              "$ref": "#/$defs/phase"
            },
            {
              "properties": {
                "phase": {
                  "const": "P1"
                }
              }
            }
          ]
        },
        "P2": {
          "allOf": [
            {
              "$ref": "#/$defs/phase"
            },
            {
              "properties": {
                "phase": {
                  "const": "P2"
                }
              }
            }
          ]
        },
        "P3": {
          "allOf": [
            {
              "$ref": "#/$defs/phase"
            },
            {
              "properties": {
                "phase": {
                  "const": "P3"
                }
              }
            }
          ]
        },
        "P4": {
          "allOf": [
            {
              "$ref": "#/$defs/phase"
            },
            {
              "properties": {
                "phase": {
                  "const": "P4"
                }
              }
            }
          ]
        },
        "P5": {
          "allOf": [
            {
              "$ref": "#/$defs/phase"
            },
            {
              "properties": {
                "phase": {
                  "const": "P5"
                }
              }
            }
          ]
        },
        "P6": {
          "allOf": [
            {
              "$ref": "#/$defs/phase"
            },
            {
              "properties": {
                "phase": {
                  "const": "P6"
                }
              }
            }
          ]
        },
        "P7": {
          "allOf": [
            {
              "$ref": "#/$defs/phase"
            },
            {
              "properties": {
                "phase": {
                  "const": "P7"
                }
              }
            }
          ]
        },
        "P8": {
          "allOf": [
            {
              "$ref": "#/$defs/phase"
            },
            {
              "properties": {
                "phase": {
                  "const": "P8"
                }
              }
            }
          ]
        },
        "P9": {
          "allOf": [
            {
              "$ref": "#/$defs/phase"
            },
            {
              "properties": {
                "phase": {
                  "const": "P9"
                }
              }
            }
          ]
        },
        "P10": {
          "allOf": [
            {
              "$ref": "#/$defs/phase"
            },
            {
              "properties": {
                "phase": {
                  "const": "P10"
                }
              }
            }
          ]
        },
        "P11": {
          "allOf": [
            {
              "$ref": "#/$defs/phase"
            },
            {
              "properties": {
                "phase": {
                  "const": "P11"
                }
              }
            }
          ]
        },
        "P12": {
          "allOf": [
            {
              "$ref": "#/$defs/phase"
            },
            {
              "properties": {
                "phase": {
                  "const": "P12"
                }
              }
            }
          ]
        },
        "P13": {
          "allOf": [
            {
              "$ref": "#/$defs/phase"
            },
            {
              "properties": {
                "phase": {
                  "const": "P13"
                }
              }
            }
          ]
        }
      }
    },
    "implementationEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "authorizedAt",
        "authorityRef",
        "nextPacket",
        "phaseGateRule",
        "productionActions"
      ],
      "properties": {
        "mode": {
          "const": "SCOPED_A0_AND_DEPENDENT_BUILD_OPEN"
        },
        "authorizedAt": {
          "const": "2026-09-24"
        },
        "authorityRef": {
          "type": "string",
          "minLength": 1
        },
        "nextPacket": {
          "const": "A0.2_READ_ONLY_RUNTIME_BASELINE"
        },
        "phaseGateRule": {
          "const": "P9_P11_OUTCOMES_OPEN_P12_ACTIVATION_P13_CLUSTER_CREATE"
        },
        "productionActions": {
          "const": "SEPARATE_AUTHORIZATION_REQUIRED"
        }
      }
    }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "codeStatus",
        "codeEvidenceBasis",
        "codeEvidenceRefs",
        "codeClaimedAt",
        "deploymentStatus",
        "deploymentEvidenceRefs",
        "programGateStatus",
        "gateEvidenceRefs",
        "blockers",
        "verifiedAt",
        "reportedAt",
        "sourceCommit"
      ],
      "properties": {
        "phase": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3",
            "P4",
            "P5",
            "P6",
            "P7",
            "P8",
            "P9",
            "P10",
            "P11",
            "P12",
            "P13"
          ]
        },
        "codeStatus": {
          "enum": [
            "PENDING",
            "IN_PROGRESS",
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        },
        "codeEvidenceBasis": {
          "enum": [
            "REPOSITORY_VERIFIED",
            "USER_CONFIRMED",
            "BOTH",
            "UNVERIFIED"
          ]
        },
        "codeEvidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "codeClaimedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "deploymentStatus": {
          "enum": [
            "NOT_DEPLOYED",
            "DEPLOYED",
            "PARTIAL",
            "UNKNOWN"
          ]
        },
        "deploymentEvidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "programGateStatus": {
          "enum": [
            "PENDING",
            "IN_PROGRESS",
            "PASS",
            "ACCEPTED_EXCEPTION",
            "BLOCKED_EXTERNAL",
            "FAIL"
          ]
        },
        "gateEvidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "description",
              "owner",
              "closesWith",
              "evidenceRefs"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "EXTERNAL_OUTCOME",
                  "PROVIDER_ACCESS",
                  "DELIVERY",
                  "OBSERVATION_WINDOW",
                  "CODE",
                  "EVIDENCE_RECONCILIATION"
                ]
              },
              "description": {
                "type": "string"
              },
              "owner": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "closesWith": {
                "type": "string"
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "verifiedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "reportedAt": {
          "type": "string"
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "codeStatus": {
                "const": "PASS"
              }
            }
          },
          "then": {
            "properties": {
              "codeEvidenceRefs": {
                "minItems": 1
              },
              "codeEvidenceBasis": {
                "enum": [
                  "REPOSITORY_VERIFIED",
                  "USER_CONFIRMED",
                  "BOTH"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "programGateStatus": {
                "enum": [
                  "PASS",
                  "ACCEPTED_EXCEPTION"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "gateEvidenceRefs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "executorPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "supervisor",
        "executor",
        "executorFamily",
        "modelResolution",
        "effortCatalog",
        "selectedEffort",
        "selectionRationale",
        "selectedEffortAccess",
        "transport",
        "orchestration",
        "automaticFallback",
        "modelId",
        "maxConcurrentAgents",
        "writerConflictDomain",
        "reviewerIdentity",
        "requireIndependentReview",
        "mergeAuthority"
      ],
      "properties": {
        "schemaVersion": {
          "const": "studio.executor-policy/2"
        },
        "supervisor": {
          "const": "GPT_SOL"
        },
        "executor": {
          "const": "CODEX_LUNA"
        },
        "executorFamily": {
          "const": "LUNA"
        },
        "modelResolution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "resolvedModelId",
            "resolvedAt",
            "evidence"
          ],
          "properties": {
            "mode": {
              "const": "RE_RESOLVE_AT_ADMISSION"
            },
            "resolvedModelId": {
              "type": "string",
              "minLength": 1
            },
            "resolvedAt": {
              "type": "string",
              "format": "date"
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "effortCatalog": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "advertised",
            "verifiedInEnvironment"
          ],
          "properties": {
            "advertised": {
              "type": "array",
              "items": {
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ]
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "verifiedInEnvironment": {
              "type": "array",
              "items": {
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ]
              },
              "uniqueItems": true,
              "minItems": 1
            }
          }
        },
        "selectedEffort": {
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "selectionRationale": {
          "type": "string",
          "minLength": 1
        },
        "selectedEffortAccess": {
          "const": "VERIFIED"
        },
        "transport": {
          "const": "RDC_CODEX_CLI"
        },
        "orchestration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "nestedCapability",
            "nativeChild"
          ],
          "properties": {
            "mode": {
              "enum": [
                "NATIVE_NESTED_AGENT",
                "SEPARATE_CLI_SESSION"
              ]
            },
            "nestedCapability": {
              "enum": [
                "AVAILABLE_AND_USED",
                "AVAILABLE_NOT_USED",
                "UNAVAILABLE",
                "NOT_PROBED"
              ]
            },
            "nativeChild": {
              "type": "boolean"
            }
          }
        },
        "automaticFallback": {
          "const": false
        },
        "maxConcurrentAgents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "writerConflictDomain": {
          "const": "ONE_WRITER"
        },
        "reviewerIdentity": {
          "const": "DISTINCT_EXECUTOR"
        },
        "requireIndependentReview": {
          "const": true
        },
        "mergeAuthority": {
          "const": "GPT_SOL"
        },
        "modelId": {
          "type": "string",
          "minLength": 1,
          "description": "Deprecated compatibility projection; when present it must equal modelResolution.resolvedModelId."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "selectedEffort": {
                "const": "low"
              }
            }
          },
          "then": {
            "properties": {
              "effortCatalog": {
                "properties": {
                  "verifiedInEnvironment": {
                    "contains": {
                      "const": "low"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "selectedEffort": {
                "const": "medium"
              }
            }
          },
          "then": {
            "properties": {
              "effortCatalog": {
                "properties": {
                  "verifiedInEnvironment": {
                    "contains": {
                      "const": "medium"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "selectedEffort": {
                "const": "high"
              }
            }
          },
          "then": {
            "properties": {
              "effortCatalog": {
                "properties": {
                  "verifiedInEnvironment": {
                    "contains": {
                      "const": "high"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "selectedEffort": {
                "const": "xhigh"
              }
            }
          },
          "then": {
            "properties": {
              "effortCatalog": {
                "properties": {
                  "verifiedInEnvironment": {
                    "contains": {
                      "const": "xhigh"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "selectedEffort": {
                "const": "max"
              }
            }
          },
          "then": {
            "properties": {
              "effortCatalog": {
                "properties": {
                  "verifiedInEnvironment": {
                    "contains": {
                      "const": "max"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "orchestration": {
                "properties": {
                  "mode": {
                    "const": "NATIVE_NESTED_AGENT"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "orchestration": {
                "properties": {
                  "nativeChild": {
                    "const": true
                  },
                  "nestedCapability": {
                    "const": "AVAILABLE_AND_USED"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "orchestration": {
                "properties": {
                  "mode": {
                    "const": "SEPARATE_CLI_SESSION"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "orchestration": {
                "properties": {
                  "nativeChild": {
                    "const": false
                  },
                  "nestedCapability": {
                    "not": {
                      "const": "AVAILABLE_AND_USED"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
